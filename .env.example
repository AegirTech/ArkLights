# 本地配置示例。首次运行 0.py 会自动复制为 .env，请填写后使用。
# 值不需要加引号；路径含空格时可用英文双引号包裹。

# main工程路径
# 例: MAIN_PROJECT_PATH=D:\Tools\懒人精灵3.8.3\script\main
MAIN_PROJECT_PATH=

# 打包的main.lr路径
# 例: LR_PATH=D:\Tools\懒人精灵3.8.3\out\main.lr
LR_PATH=

# 热更新token
TOKEN=

# PC端和模拟器共享文件夹地址,作为模拟器和PC端的中转文件夹,用于传输截图等文件
# 例: SIMULATOR_SHARED_FOLDER_PATH=sdcard\Pictures
# PC_SHARED_FOLDER_PATH=D:\我的文件\Documents\leidian9\Pictures
SIMULATOR_SHARED_FOLDER_PATH=
PC_SHARED_FOLDER_PATH=