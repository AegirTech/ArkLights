<窗口
	显示确认按钮="true"
	显示标题栏="true"
	标题="点确定">
	<标签页
		标题="注意事项"
		背景="#66ccff">
		<垂直布局
			id="idLayoutVer1"
			宽度="-1"
			高度="230"
            对齐="居中"
			背景="#002222222">
			<文本框 id="idtext" 默认值="点击最下面确定启动" 文字大小="30" 高度="-1" 宽度="-2" 边距="0,0,0,0"/>
            <文本框 id="idtext" 默认值="如果脚本启动后无法显示UI" 文字大小="30" 高度="-1" 宽度="500" 边距="0,0,0,0"/>
            <文本框 id="idtext" 默认值="可以尝试去右上角【设置】开关一下【截图服务】" 文字大小="30" 高度="-1" 宽度="500" 边距="0,0,0,0"/>
            <文本框 id="idtext" 默认值="如果脚本启动显示停止运行" 文字大小="30" 高度="-1" 宽度="500" 边距="0,0,0,0"/>
            <文本框 id="idtext" 默认值="清空数据重启即可，配置不会丢" 文字大小="30" 高度="-1" 宽度="500" 边距="0,0,0,0"/>
            <文本框 id="idtext" 默认值="脚本反馈群 891819123" 文字大小="30" 高度="-1" 宽度="-2" 边距="0,0,0,0"/>
		</垂直布局>
	</标签页>
</窗口>
